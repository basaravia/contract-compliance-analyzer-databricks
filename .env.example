# Copia este archivo a .env y ajusta los valores. NUNCA subas .env con secretos reales.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# development | production. Fuera de development: SECRET_KEY >= 32 caracteres aleatorios, cookies Secure y sin /docs
APP_ENV=development
SECRET_KEY=change-me-dev-only-not-a-real-secret
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# local    -> desarrollo sin login (usuario simulado). La app SE NIEGA a arrancar así si APP_ENV != development
# oidc     -> Microsoft Entra ID / OpenID Connect
AUTH_MODE=local

# Usuario simulado para AUTH_MODE=local

LOCAL_DEV_USER_EMAIL=dev@example.com
LOCAL_DEV_USER_NAME="Usuario de Desarrollo"

# Requeridos solo si AUTH_MODE=oidc (Microsoft Entra ID)
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback

# ---------------------------------------------------------------------------
# Embeddings / LLM (Vertex AI + LangChain)
# ---------------------------------------------------------------------------
# mock  -> proveedor local determinista, no requiere credenciales (por defecto)
# vertex -> Google Vertex AI (gemini-embedding-001 / gemini-3.6-flash)
# groq   -> solo para LLM_PROVIDER
# foundry -> Azure AI Foundry (LLM y embeddings text-embedding-3-large); sin respaldo a mock si falla
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_LLM_MODEL=gemini-3.6-flash
# Ruta al JSON de credenciales de service account (no lo subas al repo)
GOOGLE_APPLICATION_CREDENTIALS=

# Groq (solo con LLM_PROVIDER=groq). La clave es un secreto: va en .env, nunca en el repo.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=

# Segunda pasada: antes de declarar «no encontrado» se reevalúa la regla con todo el contrato
# (hasta FULL_SCAN_MAX_CHUNKS fragmentos). Cuesta 1 llamada extra al LLM solo por regla ausente.
SECOND_PASS_ENABLED=true
FULL_SCAN_MAX_CHUNKS=40

# ---------------------------------------------------------------------------
# Índice vectorial
# ---------------------------------------------------------------------------
# faiss -> índice local en memoria/disco (por defecto, MVP)
# pgvector / vertex_vector_search -> preparados a nivel de interfaz, no implementados en MVP
VECTOR_INDEX_PROVIDER=faiss

DEFAULT_JURISDICTION=EC

# ---------------------------------------------------------------------------
# Azure AI Foundry (LLM_PROVIDER=foundry / EMBEDDING_PROVIDER=foundry). En Databricks Apps el token va por
# `valueFrom` (recurso secreto), no aquí. Para probar en local, rellénalos y no los subas.
# ---------------------------------------------------------------------------
FOUNDRY_AI_ENDPOINT=
FOUNDRY_AI_API_VERSION=
FOUNDRY_AI_TOKEN=
FOUNDRY_AI_DEPLOYMENT=
FOUNDRY_AI_EMBED_DEPLOYMENT=
FOUNDRY_EMBED_DIM=3072
